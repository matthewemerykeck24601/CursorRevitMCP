  "inputSchema": {
    "type": "object",
    "properties": {
      "familyTypeId": {
        "type": "number"
      },
      "startX": {
        "type": "number"
      },
      "startY": {
        "type": "number"
      },
      "startZ": {
        "type": "number"
      },
      "endX": {
        "type": "number"
      },
      "endY": {
        "type": "number"
      },
      "endZ": {
        "type": "number"
      },
      "levelId": {
        "type": "number"
      }
    },
    "required": [
      "familyTypeId",
      "startX",
      "startY",
      "startZ",
      "endX",
      "endY",
      "endZ",
      "levelId"
    ],
    "additionalProperties": false
  }
}