{
  "name": "get_elements_by_category",
  "description": "Queries AEC Data Model REST for design elements. For Metromont: precast pieces live under Structural Framing (not Structural Columns). Pass product_prefix or say 'column' in category to force Structural Framing + COLUMN/CLA-style family filters. Pass access_token, project_id, model_urn.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "category": {
        "type": "string"
      },
      "family": {
        "type": "string"
      },
      "type": {
        "type": "string"
      },
      "limit": {
        "type": "number",
        "default": 500
      },
      "product_prefix": {
        "type": "string",
        "enum": [
          "WPA",
          "WPB",
          "CLA",
          "COLUMN",
          "ALL"
        ]
      },
      "access_token": {
        "type": "string"
      },
      "accessToken": {
        "type": "string"
      },
      "model_urn": {
        "type": "string"
      },
      "urn": {
        "type": "string"
      },
      "project_id": {
        "type": "string"
      },
      "projectId": {
        "type": "string"
      },
      "hub_id": {
        "type": "string"
      },
      "hubId": {
        "type": "string"
      }
    },
    "required": []
  }
}