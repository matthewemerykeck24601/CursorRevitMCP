{
  "name": "create_dimensions",
  "description": "Create dimension annotations in the current Revit view. Supports dimensioning between elements (walls, doors, windows) by element IDs, or between two points with automatic reference detection. All coordinates are in millimeters (mm).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "dimensions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "startPoint": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "description": "X coordinate in mm"
                },
                "y": {
                  "type": "number",
                  "description": "Y coordinate in mm"
                },
                "z": {
                  "type": "number",
                  "description": "Z coordinate in mm"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ],
              "additionalProperties": false,
              "description": "Start point of the dimension line (mm)"
            },
            "endPoint": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "description": "X coordinate in mm"
                },
                "y": {
                  "type": "number",
                  "description": "Y coordinate in mm"
                },
                "z": {
                  "type": "number",
                  "description": "Z coordinate in mm"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ],
              "additionalProperties": false,
              "description": "End point of the dimension line (mm)"
            },
            "linePoint": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "description": "X coordinate in mm"
                },
                "y": {
                  "type": "number",
                  "description": "Y coordinate in mm"
                },
                "z": {
                  "type": "number",
                  "description": "Z coordinate in mm"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ],
              "additionalProperties": false,
              "description": "Location of the dimension line itself (mm). If not provided, defaults to midpoint offset by 1 foot"
            },
            "elementIds": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Element IDs to dimension between. If provided, references are extracted from these elements. If empty, references are auto-detected at start/end points"
            },
            "dimensionType": {
              "type": "string",
              "default": "Linear",
              "description": "Dimension type (default: 'Linear')"
            },
            "dimensionStyleId": {
              "type": "number",
              "default": -1,
              "description": "Element ID of the dimension style to apply. -1 for default style"
            },
            "viewId": {
              "type": "number",
              "default": -1,
              "description": "Element ID of the view to create the dimension in. -1 for active view"
            }
          },
          "required": [
            "startPoint",
            "endPoint"
          ],
          "additionalProperties": false
        },
        "description": "Array of dimensions to create"
      }
    },
    "required": [
      "dimensions"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}