<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Scoped NuGet config for this project. The machine-level config references a local
    Syncfusion source that does not exist on this box; <clear/> drops it so restore uses
    only nuget.org (needed for the net48 / Revit 2024 target: System.Text.Json + PolySharp).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
