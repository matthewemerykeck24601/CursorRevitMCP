          "WPB",
          "CLA",
          "COLUMN",
          "ALL"
        ],
        "default": "ALL"
      },
      "dry_run": {
        "type": "boolean",
        "default": true
      },
      "access_token": {
        "type": "string"
      },
      "accessToken": {
        "type": "string"
      },
      "model_urn": {
        "type": "string"
      },
      "urn": {
        "type": "string"
      },
      "project_id": {
        "type": "string"
      },
      "projectId": {
        "type": "string"
      },
      "hub_id": {
        "type": "string"
      },
      "hubId": {
        "type": "string"
      }
    },
    "required": []
  }
}