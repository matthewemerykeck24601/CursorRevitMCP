    "type": "object",
    "properties": {
      "elementIds": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "deltaX": {
        "type": "number"
      },
      "deltaY": {
        "type": "number"
      },
      "deltaZ": {
        "type": "number"
      }
    },
    "required": [
